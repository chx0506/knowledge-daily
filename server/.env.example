# ============================================================
# AI 电子报纸 · 后端环境变量模板
# 复制为 .env 并填入真实值。.env 已被 .gitignore 忽略，绝不要提交。
# ============================================================

# --- 服务 ---
PORT=3000
# 公网可访问的站点根地址；本地开发用 http://127.0.0.1:3000
PUBLIC_BASE_URL=http://127.0.0.1:3000

# --- 知乎开放平台 Access Secret ---
# 获取：https://developer.zhihu.com/profile
# 本机已配置在系统钥匙串，可用下面命令导出（不要把结果贴进聊天或仓库）：
#   ZHIHU_ACCESS_SECRET=$(security find-generic-password -s zhihu-cli -w)
ZHIHU_ACCESS_SECRET=

# --- 黑客松 OAuth 凭证 ---
# 获取：https://www.zhihu.com/hackathon?activity_code=zhihu_hackathon_2026_p2
# 队伍详情 → 「查看分配的三方应用的 APP_ID 和 KEY」
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=

# 必须与赛事页面登记值「完全一致」：协议、域名、端口、路径、尾斜杠、Query 参数
ZHIHU_OAUTH_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback

# --- 业务参数 ---
# 免费兴趣槽位数（纪要 17:20 定为 3）
FREE_SLOT_QUOTA=3
# 画像时间窗口（天）
PROFILE_WINDOW_DAYS=60
# 登录成功后前端跳转地址
LOGIN_SUCCESS_REDIRECT=/
